Output demo/cet-linkedin.gif

Set FontSize 16
Set Width 900
Set Height 400
Set Theme "Dracula"
Set Shell zsh
Set WaitTimeout 15s
Set Padding 20

Type "source /private/var/www/claude-engineer-toolkit/.venv/bin/activate && export ANTHROPIC_API_KEY=dummy"
Enter
Sleep 1s

Type "cet explain cet/tools/pr_review.py --mock"
Enter
Sleep 8s
